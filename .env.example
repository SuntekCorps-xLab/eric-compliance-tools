VITE_API_MODE=mock
# These public placeholders are used only when VITE_API_MODE=live.
# Never put Shopify app secrets, Admin API tokens, passwords, or private keys here.
VITE_API_BASE_URL=https://tenant-api.example.com
VITE_GATEWAY_BASE_URL=https://tenant-api.example.com
VITE_SHOPIFY_AUTHORIZE_PATH=/auth/shopify/login
VITE_SHOPIFY_EXCHANGE_PATH=/auth/shopify/exchange
VITE_ERIC_LOGIN_PATH=/login/passwd
# Optional standalone compatibility preview. Shopify storefront builds ignore it.
VITE_PASSWORD_DEMO_LOGIN=false
# Optional public key override; use escaped newlines. This is not a private key or client secret.
# VITE_LOGIN_RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
VITE_ACCOUNT_PATH=/account/account
VITE_LOGOUT_PATH=/logout
# Compliance API base used by the standalone live compatibility preview.
VITE_DETECTION_API_BASE_URL=https://compliance-api.example.com/Eric
